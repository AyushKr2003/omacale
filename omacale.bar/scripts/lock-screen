#!/usr/bin/env python3
"""Hand Omarchy's lock screen over to Omacale (and give it back).

Omarchy's lock is a first-party shell plugin (`omarchy.lock`): a
`WlSessionLock` whose service owns PAM, the stranded-lock recovery, the
blank-on-idle timers and the `lock` IPC that `omarchy system lock`,
`omarchy-system-sleep-lock` and the lid binding all call. None of that is
worth reimplementing, and a second session lock is not allowed beside it, so
Omacale takes the one part it wants -- the view -- and leaves the rest.

Omarchy documents the route: `omarchy plugin clone` copies a built-in plugin
into ~/.config/omarchy/plugins/, disables the built-in and routes its IPC to
the clone. This script clones the lock plugin once and then, on every run, rebuilds the
clone from the installed Omarchy (see handover.py):

  * every stock file is copied in untouched -- `Service.qml` included -- so
    the clone picks up Omarchy's lock fixes instead of freezing at clone
    time, and files upstream removed leave it;
  * the stock view is kept beside it as `StockLockView.qml`;
  * `LockView.qml` is written from assets/lock/LockView.qml -- a wrapper that
    loads Omacale's LockUi.qml by URL and falls back to the stock view when
    Omacale is off, missing or broken;
  * the manifest takes stock's capabilities, kinds and entry points.

Before writing anything it checks that every property and signal the stock
`Service.qml` drives its view with exists on the wrapper. If `omarchy update`
reshapes that contract the script refuses rather than leave the machine with
a lock screen that cannot load.

  lock-screen install    clone (if needed) + refresh; the shell picks the
                         clone up live, so --restart is only for installers
  lock-screen remove     give the lock back to Omarchy
  lock-screen status     report what is in place (parsable, key: value)
  lock-screen health     is the lock service answering, with PAM? (exit 0/1)
  lock-screen watchdog   re-sync a stale clone (only while unlocked), then
                         check its health and give the lock back to Omarchy
                         if it is broken -- a machine that cannot lock is
                         worse than one with the stock lock screen
"""

import json
import os
import re
import subprocess
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
# The installed copy lives under the plugins folder, where a __pycache__
# written on import would reload every plugin.
sys.dont_write_bytecode = True
sys.path.insert(0, HERE)
import handover  # noqa: E402

MARKER = "omacale:lock-view v3"

HOME = os.path.expanduser("~")
PLUGINS_DIR = os.path.join(HOME, ".config", "omarchy", "plugins")
SOURCE_ID = "omarchy.lock"
STOCK_DIR = os.path.join(
    os.environ.get("OMARCHY_PATH", "/usr/share/omarchy"),
    "shell", "plugins", "lock",
)

PLUGIN_DIR = os.path.dirname(HERE)
TEMPLATE = os.path.join(PLUGIN_DIR, "assets", "lock", "LockView.qml")
SETTINGS = os.path.join(HOME, ".config", "omacale", "settings.json")


def fail(msg):
    print(f"lock-screen: {msg}", file=sys.stderr)
    sys.exit(1)


def run(cmd, **kwargs):
    return subprocess.run(cmd, text=True, capture_output=True, **kwargs)


def clone_dir():
    """The lock clone, whatever it is called: `omarchy plugin clone` names it
    after the user, and a machine may have been set up under another name."""
    if not os.path.isdir(PLUGINS_DIR):
        return None
    for name in sorted(os.listdir(PLUGINS_DIR)):
        if name.startswith("."):
            continue
        manifest = os.path.join(PLUGINS_DIR, name, "manifest.json")
        try:
            with open(manifest) as f:
                data = json.load(f)
        except (OSError, ValueError):
            continue
        if data.get("omarchy", {}).get("clonedFrom") == SOURCE_ID:
            return os.path.join(PLUGINS_DIR, name)
    return None


def plugin_enabled(plugin_id):
    proc = run(["omarchy-shell", "shell", "listPlugins"])
    try:
        for row in json.loads(proc.stdout):
            if row.get("id") == plugin_id:
                return bool(row.get("enabled"))
    except ValueError:
        pass
    return False


def view_state(target):
    """Which view the clone draws with: ours (and its version), or Omarchy's."""
    path = os.path.join(target, "LockView.qml")
    try:
        with open(path) as f:
            head = f.read(4096)
    except OSError:
        return "missing"
    match = re.search(r"omacale:lock-view v(\d+)", head)
    if match:
        return f"omacale v{match.group(1)}"
    return "omarchy"


# --------------------------------------------------------------- the contract
#
# Service.qml drives its view through property assignments and signal
# handlers inside `LockView { ... }`. The wrapper has to accept every one of
# them, or the whole lock plugin fails to load.

def view_usage(service_qml):
    """Every property and signal handler Service.qml sets on its LockView."""
    names = set()
    for match in re.finditer(r"\bLockView\s*\{", service_qml):
        depth = 0
        i = match.end() - 1
        for j in range(i, len(service_qml)):
            char = service_qml[j]
            if char == "{":
                depth += 1
            elif char == "}":
                depth -= 1
                if depth == 0:
                    block = service_qml[i + 1:j]
                    break
        else:
            fail("could not read a LockView block in Service.qml")
        # Only the block's own top-level assignments; nested items bring
        # their own properties and are not ours to satisfy.
        inner = 0
        for line in block.splitlines():
            stripped = line.strip()
            if inner == 0:
                found = re.match(r"^(on)?([A-Za-z_][A-Za-z0-9_]*)\s*:", stripped)
                if found and found.group(0) != "id:":
                    name = found.group(2)
                    names.add(name[0].lower() + name[1:] if found.group(1) else name)
            inner += line.count("{") - line.count("}")
    return names


def view_provides(template_qml):
    """Every property and signal the wrapper declares."""
    names = set(re.findall(r"^\s*(?:readonly\s+)?property\s+\S+\s+([A-Za-z_]\w*)", template_qml, re.M))
    names |= set(re.findall(r"^\s*signal\s+([A-Za-z_]\w*)", template_qml, re.M))
    return names


def check_contract(service_qml, template_qml):
    used = view_usage(service_qml)
    if not used:
        fail(f"{STOCK_DIR}/Service.qml has no LockView block; refusing to patch a lock plugin this script does not recognise")
    missing = sorted(used - view_provides(template_qml))
    if missing:
        fail(
            "Omarchy's lock service now drives its view with "
            + ", ".join(missing)
            + ".\nUpdate assets/lock/LockView.qml (and LockUi.qml) to match before installing."
        )


# ----------------------------------------------------------------- the actions

def restart_shell():
    run(["omarchy-restart-shell"])


def install(restart=False):
    for name in ("Service.qml", "LockView.qml"):
        if not os.path.isfile(os.path.join(STOCK_DIR, name)):
            fail(f"{STOCK_DIR}/{name} is missing; is this Omarchy?")
    if not os.path.isfile(TEMPLATE):
        fail(f"{TEMPLATE} is missing")

    with open(os.path.join(STOCK_DIR, "Service.qml")) as f:
        service_qml = f.read()
    with open(TEMPLATE) as f:
        template_qml = f.read()

    check_contract(service_qml, template_qml)

    target = clone_dir()
    if target is None:
        proc = run(["omarchy-plugin-clone", SOURCE_ID])
        if proc.returncode != 0:
            fail(proc.stderr.strip() or "omarchy plugin clone failed")
        target = clone_dir()
        if target is None:
            fail("the cloned lock plugin was not found after cloning")
        print(f"cloned {SOURCE_ID} to {target}")

    # Omarchy's plugin, verbatim: rebuilt every run so the clone follows
    # `omarchy update` instead of freezing at the version it was cloned from.
    changed = plan(target, template_qml).apply()
    for rel in changed:
        print(f"  synced {rel}")

    plugin_id = os.path.basename(target)
    if not plugin_enabled(plugin_id):
        proc = run(["omarchy-plugin-enable", plugin_id])
        if proc.returncode != 0:
            fail(proc.stderr.strip() or f"could not enable {plugin_id}")

    print(f"lock view: {view_state(target)} ({plugin_id})" + ("" if changed else " (already in place)"))
    if restart:
        restart_shell()
    return 0


def plan(target, template_qml):
    """The clone as it should be: stock, with the view renamed and our
    wrapper in its place."""
    tree = handover.stock_tree(STOCK_DIR)
    tree["StockLockView.qml"] = tree.pop("LockView.qml")
    tree["LockView.qml"] = template_qml.encode()
    return handover.Plan(STOCK_DIR, target, tree)


def stale_files(target):
    try:
        with open(TEMPLATE) as f:
            template_qml = f.read()
    except OSError:
        return ["LockView.qml (no template)"]
    return plan(target, template_qml).stale_files()


def remove(restart=False):
    target = clone_dir()
    if target is None:
        print("nothing to remove: Omarchy already draws the lock screen")
        return 0

    plugin_id = os.path.basename(target)
    proc = run(["omarchy-plugin-remove", plugin_id, "--yes"])
    if proc.returncode != 0:
        fail(proc.stderr.strip() or f"could not remove {plugin_id}")
    print(f"removed {plugin_id}; {SOURCE_ID} draws the lock screen again")
    if restart:
        restart_shell()
    return 0


def omacale_enabled():
    try:
        with open(SETTINGS) as f:
            lock = json.load(f).get("lock") or {}
    except (OSError, ValueError):
        return True
    return lock.get("enabled", False) is not False


def status():
    target = clone_dir()
    if target is None:
        print("clone:     none")
        print("view:      omarchy")
        print("stale:     no")
    else:
        plugin_id = os.path.basename(target)
        print(f"clone:     {plugin_id} ({'enabled' if plugin_enabled(plugin_id) else 'disabled'})")
        print(f"view:      {view_state(target)}")
        stale = stale_files(target)
        print(f"stale:     {'yes' if stale else 'no'}")
        if stale:
            print(f"stale-files: {', '.join(stale)}")
    # The wrapper the *installed* Omacale would write. An older one still says
    # "omacale", but points at a LockUi.qml that has since moved, so the lock
    # would quietly fall back to the stock view; LockService compares the two
    # and re-installs when they differ.
    print(f"expects:   omacale v{MARKER.rsplit('v', 1)[1]}")
    print(f"setting:   {'on' if omacale_enabled() else 'off'}")
    return 0


# ------------------------------------------------------------------- health

def locked():
    return handover.ipc("lock", "isLocked") == "true"


def probe():
    """Healthy: the `lock` IPC answers and PAM is configured. A lock that is
    up right now is by definition healthy enough to leave alone."""
    raw = handover.ipc("lock", "status")
    if raw is None:
        return False, "the lock service does not answer (`omarchy-shell lock status`)"
    try:
        state = json.loads(raw)
    except ValueError:
        return False, "the lock service answered with something that is not its status"
    if state.get("locked"):
        return True, ""
    if state.get("passwordPam") is not True:
        return False, "the lock service has no password PAM"
    return True, ""


def health():
    verdict, reason = handover.checked(probe)
    print(f"health:    {verdict}")
    if reason:
        print(f"reason:    {reason}")
    return 0 if verdict != "fail" else 1


def watchdog():
    """Heal what an `omarchy update` did to the clone: re-sync it, and if the
    lock service is then broken, hand the lock back to Omarchy."""
    target = clone_dir()
    if target is None:
        print("action:    none")
        return 0

    action = "none"
    if stale_files(target):
        # A service swapped under a live lock is not a risk worth taking; the
        # next check after unlocking catches up.
        if locked():
            action = "skipped-locked"
        else:
            try:
                install()
                action = "synced"
            except SystemExit:
                # check_contract refused (its reason is on stderr): the old
                # clone keeps running and the health check decides.
                action = "refused"

    verdict, reason = handover.checked(probe)
    if verdict == "fail":
        remove()
        action = "fellback"
    print(f"action:    {action}")
    print(f"health:    {verdict}")
    if reason:
        print(f"reason:    {reason}")
    return 0


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0

    action, *rest = argv
    # The shell enables the clone and reloads its files live, so a restart is
    # never needed here; installers that want a clean slate can ask for one.
    restart = "--restart" in rest
    if action == "install":
        return install(restart)
    if action == "remove":
        return remove(restart)
    if action == "status":
        return status()
    if action == "health":
        return health()
    if action == "watchdog":
        return watchdog()
    fail(f"unknown action: {action}")


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
